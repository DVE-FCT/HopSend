{
  "openapi": "3.1.0",
  "info": {
    "title": "HopSend Agent 控制接口",
    "version": "0.4.0",
    "description": "受认证的 HTTPS 控制面，提供健康、能力、授权目录、已发布路径版本和不可变文件清单。目录支持稳定名称排序分页；文件字节通过独立 SFTP 传输。"
  },
  "servers": [
    {
      "url": "https://localhost:9443"
    }
  ],
  "security": [
    {
      "deviceToken": []
    }
  ],
  "paths": {
    "/v1/health": {
      "get": {
        "operationId": "health",
        "summary": "受认证的健康与版本信息",
        "responses": {
          "200": {
            "description": "成功",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          },
          "401": {
            "description": "凭据缺失或无效",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "default": {
            "description": "结构化错误，不含绝对路径或凭据",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/v1/capabilities": {
      "get": {
        "operationId": "capabilities",
        "summary": "仅声明当前已实现的控制能力",
        "responses": {
          "200": {
            "description": "成功",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Capabilities"
                }
              }
            }
          },
          "401": {
            "description": "凭据缺失或无效",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "default": {
            "description": "结构化错误，不含绝对路径或凭据",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/v1/shares": {
      "get": {
        "operationId": "shares",
        "summary": "列出当前凭据获准访问的共享 ID，不返回系统路径",
        "responses": {
          "200": {
            "description": "成功",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ShareList"
                }
              }
            }
          },
          "401": {
            "description": "凭据缺失或无效",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "default": {
            "description": "结构化错误，不含绝对路径或凭据",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/v1/shares/{share_id}/entries": {
      "get": {
        "operationId": "listEntries",
        "summary": "只读目录信息，拒绝越界和目录链接",
        "responses": {
          "200": {
            "description": "成功",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EntryList"
                }
              }
            }
          },
          "401": {
            "description": "凭据缺失或无效",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "default": {
            "description": "结构化错误，不含绝对路径或凭据",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "400": {
            "description": "路径、limit 或 cursor 无效，或目标不是目录；Agent 重启后的旧游标也会失效",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "目录不可访问",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "共享未知或未授权",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "目录在分页期间发生变化，游标失效，客户端应从第一页重新读取",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "413": {
            "description": "目录超过 100000 项扫描上限（不是单页限制）",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "share_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,63}$"
            }
          },
          {
            "name": "path",
            "in": "query",
            "required": false,
            "description": "共享内相对目录，默认 .；不接受绝对路径、..、反斜线、冒号及目录链接",
            "schema": {
              "type": "string",
              "default": "."
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "description": "单页项目数，默认 100，最大 500",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 500,
              "default": 100
            }
          },
          {
            "name": "cursor",
            "in": "query",
            "required": false,
            "description": "上一页返回的不透明签名游标，原样传回；不可跨共享/相对目录复用。目录变化或 Agent 重启后应从第一页重读。",
            "schema": {
              "type": "string",
              "maxLength": 4096
            }
          }
        ],
        "description": "按 UTF-8 名称字节序排列。默认 100、最大 500 项/页；cursor 是 Agent 签名的不透明游标，绑定共享、相对目录和目录元数据指纹。分页间检测到变化返回 409 cursor_stale，必须丢弃已有结果并从第一页重试。Agent 重启后游标失效（400 invalid_cursor）。每页重新扫描元数据，最多扫描 100000 项；不提供原子文件系统快照或文件内容版本保证。"
      }
    },
    "/v1/shares/{share_id}/manifests/{manifest_id}": {
      "get": {
        "operationId": "publishedManifest",
        "summary": "读取已发布且属于授权共享的不可变清单",
        "parameters": [
          {
            "name": "share_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,63}$"
            }
          },
          {
            "name": "manifest_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "已认证的内容版本与 SFTP 对象路径",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PublishedManifest"
                }
              }
            }
          },
          "401": {
            "description": "凭据缺失或无效",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "清单未知、损坏、未配置或不属于获授权共享",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
