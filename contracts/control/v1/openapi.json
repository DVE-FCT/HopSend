{
  "openapi": "3.1.0",
  "info": {
    "title": "HopSend Agent 控制接口",
    "version": "0.2.0",
    "description": "受认证的 HTTPS 控制面，提供健康、能力、授权目录和已发布不可变文件清单。文件字节通过独立 SFTP 传输；上传能力尚未实现。"
  },
  "servers": [
    {
      "url": "https://localhost:9443"
    }
  ],
  "security": [
    {
      "deviceToken": []
    }
  ],
  "paths": {
    "/v1/health": {
      "get": {
        "operationId": "health",
        "summary": "受认证的健康与版本信息",
        "responses": {
          "200": {
            "description": "成功",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          },
          "401": {
            "description": "凭据缺失或无效",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "default": {
            "description": "结构化错误，不含绝对路径或凭据",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/v1/capabilities": {
      "get": {
        "operationId": "capabilities",
        "summary": "仅声明当前已实现的控制能力",
        "responses": {
          "200": {
            "description": "成功",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Capabilities"
                }
              }
            }
          },
          "401": {
            "description": "凭据缺失或无效",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "default": {
            "description": "结构化错误，不含绝对路径或凭据",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/v1/shares": {
      "get": {
        "operationId": "shares",
        "summary": "列出当前凭据获准访问的共享 ID，不返回系统路径",
        "responses": {
          "200": {
            "description": "成功",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ShareList"
                }
              }
            }
          },
          "401": {
            "description": "凭据缺失或无效",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "default": {
            "description": "结构化错误，不含绝对路径或凭据",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/v1/shares/{share_id}/entries": {
      "get": {
        "operationId": "listEntries",
        "summary": "只读目录信息，拒绝越界和目录链接",
        "responses": {
          "200": {
            "description": "成功",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EntryList"
                }
              }
            }
          },
          "401": {
            "description": "凭据缺失或无效",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "default": {
            "description": "结构化错误，不含绝对路径或凭据",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "400": {
            "description": "路径格式无效或不是目录",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "目录不可访问",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "共享未知或未授权",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "413": {
            "description": "超过单次 1000 项目录上限",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "share_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,63}$"
            }
          },
          {
            "name": "path",
            "in": "query",
            "required": false,
            "description": "共享内相对目录，默认 .；不接受绝对路径、..、反斜线、冒号及目录链接",
            "schema": {
              "type": "string",
              "default": "."
            }
          }
        ]
      }
    },
    "/v1/shares/{share_id}/manifests/{manifest_id}": {
      "get": {
        "operationId": "publishedManifest",
        "summary": "读取已发布且属于授权共享的不可变清单",
        "parameters": [
          {
            "name": "share_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,63}$"
            }
          },
          {
            "name": "manifest_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "已认证的内容版本与 SFTP 对象路径",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PublishedManifest"
                }
              }
            }
          },
          "401": {
            "description": "凭据缺失或无效",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "清单未知、损坏、未配置或不属于获授权共享",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "deviceToken": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "32 random bytes encoded as 64 hex characters"
      }
    },
    "schemas": {
      "Health": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "status",
          "service",
          "version",
          "api_version"
        ],
        "properties": {
          "status": {
            "const": "ok"
          },
          "service": {
            "const": "hopsend-agent"
          },
          "version": {
            "type": "string"
          },
          "api_version": {
            "const": "v1"
          }
        }
      },
      "Capabilities": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "api_version",
          "operations",
          "data_transport",
          "upload_supported"
        ],
        "properties": {
          "api_version": {
            "const": "v1"
          },
          "operations": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "data_transport": {
            "const": "external_sftp"
          },
          "upload_supported": {
            "const": false
          }
        }
      },
      "Share": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "access"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,63}$"
          },
          "access": {
            "const": "read_only"
          }
        }
      },
      "ShareList": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "shares"
        ],
        "properties": {
          "shares": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Share"
            }
          }
        }
      },
      "Entry": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "directory",
          "size_bytes"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "directory": {
            "type": "boolean"
          },
          "size_bytes": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          }
        }
      },
      "EntryList": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "share_id",
          "path",
          "entries"
        ],
        "properties": {
          "share_id": {
            "type": "string"
          },
          "path": {
            "type": "string"
          },
          "entries": {
            "type": "array",
            "maxItems": 1000,
            "items": {
              "$ref": "#/components/schemas/Entry"
            }
          }
        }
      },
      "Error": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "code",
              "message"
            ],
            "properties": {
              "code": {
                "type": "string"
              },
              "message": {
                "type": "string"
              }
            }
          }
        }
      },
      "Manifest": {
        "title": "HopSend immutable file manifest v1",
        "type": "object",
        "additionalProperties": false,
        "description": "manifest_id is SHA-256 of UTF-8 compact Go JSON for these fields in declaration order with manifest_id set to empty string. Offsets must be contiguous; lengths sum to size_bytes; content_id is full-file SHA-256. These invariants are additionally checked by the client.",
        "required": [
          "schema_version",
          "manifest_id",
          "content_id",
          "share_id",
          "name",
          "size_bytes",
          "chunk_size_bytes",
          "chunks"
        ],
        "properties": {
          "schema_version": {
            "const": 1
          },
          "manifest_id": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "content_id": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "share_id": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,63}$"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "description": "Single Windows-safe filename, not an absolute or relative directory path"
          },
          "size_bytes": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          },
          "chunk_size_bytes": {
            "type": "integer",
            "minimum": 65536,
            "maximum": 67108864
          },
          "chunks": {
            "type": "array",
            "maxItems": 65536,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "index",
                "offset",
                "length",
                "sha256"
              ],
              "properties": {
                "index": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 65535
                },
                "offset": {
                  "type": "integer",
                  "format": "int64",
                  "minimum": 0
                },
                "length": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 67108864
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                }
              }
            }
          }
        }
      },
      "PublishedManifest": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "manifest",
          "sftp_path"
        ],
        "properties": {
          "manifest": {
            "$ref": "#/components/schemas/Manifest"
          },
          "sftp_path": {
            "type": "string",
            "minLength": 1,
            "description": "Authenticated SFTP path to the published content snapshot; never use a mutable source path"
          }
        }
      }
    }
  }
}
