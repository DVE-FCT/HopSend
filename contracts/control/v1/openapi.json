    "/v1/shares/{share_id}/index": {
      "get": {
        "operationId": "publishedPathIndex",
        "summary": "读取授权共享内最后一次显式发布的不可变版本",
        "description": "path 是共享内规范相对路径。查询不复制或哈希实时源文件；未显式发布返回 path_unpublished。返回的 manifest_id 固定对应已发布快照，源文件后来变化不会悄悄切换版本。",
        "parameters": [
          {
            "name": "share_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,63}$"
            }
          },
          {
            "name": "path",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "description": "共享内相对文件或文件夹路径；不接受绝对路径、..、反斜线、冒号或链接"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "已发布路径版本",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PathVersion"
                }
              }
            }
          },
          "400": {
            "description": "路径无效",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "凭据缺失或无效",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "共享未授权或路径尚未发布（path_unpublished）",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "索引、清单或内容对象不可用（index_stale）",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "deviceToken": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "32 random bytes encoded as 64 hex characters"
      }
    },
    "schemas": {
      "Health": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "status",
          "service",
          "version",
          "api_version"
        ],
        "properties": {
          "status": {
            "const": "ok"
          },
          "service": {
            "const": "hopsend-agent"
          },
          "version": {
            "type": "string"
          },
          "api_version": {
            "const": "v1"
          }
        }
      },
      "Capabilities": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "api_version",
          "operations",
          "data_transport",
          "upload_supported"
        ],
        "properties": {
          "api_version": {
            "const": "v1"
          },
          "operations": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "data_transport": {
            "const": "external_sftp"
          },
          "upload_supported": {
            "const": false
          }
        }
      },
      "Share": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "access"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,63}$"
          },
          "access": {
            "enum": [
              "read_only",
              "write_only",
              "read_write"
            ]
          }
        }
      },
      "ShareList": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "shares"
        ],
        "properties": {
          "shares": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Share"
            }
          }
        }
      },
      "Entry": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "directory",
          "size_bytes"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "directory": {
            "type": "boolean"
          },
          "size_bytes": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          }
        }
      },
      "EntryList": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "share_id",
          "path",
          "entries",
          "next_cursor",
          "has_more"
        ],
        "properties": {
          "share_id": {
            "type": "string"
          },
          "path": {
            "type": "string"
          },
          "entries": {
            "type": "array",
            "maxItems": 500,
            "items": {
              "$ref": "#/components/schemas/Entry"
            }
          },
          "next_cursor": {
            "type": "string",
            "maxLength": 4096,
            "description": "下一页游标；最后一页为空字符串"
          },
          "has_more": {
            "type": "boolean",
            "description": "是否还有下一页"
          }
        },
        "description": "按名称 UTF-8 字节序排序的一页目录；has_more 与 next_cursor 是否非空一致。扫描中或分页间检测到元数据变化返回 cursor_stale。目录枚举不等于原子快照，内容身份由不可变 manifest 校验。"
      },
      "Error": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "code",
              "message"
            ],
            "properties": {
              "code": {
                "type": "string"
              },
              "message": {
                "type": "string"
              }
            }
          }
        }
      },
      "Manifest": {
        "title": "HopSend immutable file manifest v1",
        "type": "object",
        "additionalProperties": false,
        "description": "manifest_id is SHA-256 of UTF-8 compact Go JSON for these fields in declaration order with manifest_id set to empty string. Offsets must be contiguous; lengths sum to size_bytes; content_id is full-file SHA-256. These invariants are additionally checked by the client.",
        "required": [
          "schema_version",
          "manifest_id",
          "content_id",
          "share_id",
          "name",
          "size_bytes",
          "chunk_size_bytes",
          "chunks"
        ],
        "properties": {
          "schema_version": {
            "const": 1
          },
          "manifest_id": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "content_id": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "share_id": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,63}$"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "description": "Single Windows-safe filename, not an absolute or relative directory path"
          },
          "size_bytes": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          },
          "chunk_size_bytes": {
            "type": "integer",
            "minimum": 65536,
            "maximum": 67108864
          },
          "chunks": {
            "type": "array",
            "maxItems": 65536,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "index",
                "offset",
                "length",
                "sha256"
              ],
              "properties": {
                "index": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 65535
                },
                "offset": {
                  "type": "integer",
                  "format": "int64",
                  "minimum": 0
                },
                "length": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 67108864
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                }
              }
            }
          },
          "payload_kind": {
            "const": "folder"
          }
        }
      },
      "PublishedManifest": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "manifest",
          "sftp_path"
        ],
        "properties": {
          "manifest": {
            "$ref": "#/components/schemas/Manifest"
          },
          "sftp_path": {
            "type": "string",
            "minLength": 1,
            "description": "Authenticated SFTP path to the published content snapshot; never use a mutable source path"
          }
        }
      },
      "UploadSession": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "request_id",
          "share_id",
          "target",
          "manifest_id",
          "state",
          "sftp_path",
          "confirmed_chunks"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-f0-9]{32}$"
          },
          "request_id": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "share_id": {
            "type": "string"
          },
          "target": {
            "type": "string"
          },
          "manifest_id": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "state": {
            "enum": [
              "uploading",
              "verifying",
              "publishing",
              "completed"
            ]
          },
          "sftp_path": {
            "type": "string"
          },
          "confirmed_chunks": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "integer",
              "minimum": 0
            }
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      },
      "CreateUpload": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "request_id",
          "share_id",
          "target",
          "manifest"
        ],
        "properties": {
          "request_id": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "share_id": {
            "type": "string"
          },
          "target": {
            "type": "string",
            "description": "当前为安全的 Windows 单级文件名"
          },
          "manifest": {
            "$ref": "#/components/schemas/Manifest"
          }
        }
      },
      "PathVersion": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "share_id",
          "path",
          "manifest_id",
          "content_id",
          "name",
          "size_bytes",
          "payload_kind",
          "published_at"
        ],
        "properties": {
          "share_id": {
            "type": "string"
          },
          "path": {
            "type": "string"
          },
          "manifest_id": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "content_id": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "name": {
            "type": "string"
          },
          "size_bytes": {
            "type": "integer",
            "minimum": 0
          },
          "payload_kind": {
            "type": "string",
            "enum": [
              "file",
              "folder"
            ]
          },
          "published_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    }
  }
}
